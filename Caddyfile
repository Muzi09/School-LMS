# =============================================================
# Caddyfile — Reverse Proxy & Static Frontend Server
# =============================================================
# WHAT THIS DOES:
# 1. Serves the built React Web App (HTML/CSS/JS) to visitors.
# 2. Forwards all API requests (/api/*, /docs, /ws/*) to FastAPI.
# 3. Forwards uploaded media (/uploads/*) to the backend.
# 4. Supports React Router (single-page-app routing fallback).
# =============================================================

:80 {
    # ── 1. Backend API & Documentation ─────────────────────
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /docs* {
        reverse_proxy backend:8000
    }

    handle /redoc* {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    # ── 2. Real-time WebSocket Chat ────────────────────────
    handle /ws/* {
        reverse_proxy backend:8000
    }

    # ── 3. Uploaded Files (School emblems, homework) ───────
    handle /uploads/* {
        reverse_proxy backend:8000
    }

    # ── 4. React Web Application (SPA) ─────────────────────
    root * /srv/dist
    file_server

    # Any non-file URL (e.g. /login, /dashboard) loads index.html
    try_files {path} /index.html
}
