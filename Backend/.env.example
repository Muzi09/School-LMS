# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/school_lms_db

# Security & JWT Configuration
JWT_SECRET=your-secure-random-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Onboarding & Application URLs
ONBOARDING_TOKEN_EXPIRE_HOURS=72
FRONTEND_URL=http://localhost:5173

# Admin Default Seed Credentials
ADMIN_DEFAULT_EMAIL=admin@platform.com
ADMIN_DEFAULT_PASSWORD=Admin@123
ADMIN_DEFAULT_FIRST_NAME=Admin
ADMIN_DEFAULT_LAST_NAME=User
ADMIN_DEFAULT_MOBILE=9999999999
