# =============================================================
# Production Environment Variables for AWS Server
# =============================================================
# WHAT IS THIS FILE?
# This file stores secret credentials (passwords, secret keys).
# On your AWS server, you will copy this to a file named ".env"
# and fill in strong, unique secrets.
#
# Docker Compose will automatically read these variables.
# =============================================================

# 1. Database Secret Password
# Choose a strong password for your PostgreSQL database:
DB_PASSWORD=SuperSecretDatabasePassword2026!

# 2. JWT Security Key
# This is like a master stamp used to sign login tokens.
# Mobile users get a token stamped with this secret key.
JWT_SECRET=generate-a-long-random-string-here-minimum-32-characters

# 3. Allowed Frontend URLs
# Put your production web frontend URL or IP here (comma-separated if multiple):
FRONTEND_URL=http://localhost:5173

# 4. Super Admin Credentials (Created on initial database seed)
ADMIN_DEFAULT_EMAIL=admin@platform.com
ADMIN_DEFAULT_PASSWORD=Admin@123
ADMIN_DEFAULT_FIRST_NAME=Admin
ADMIN_DEFAULT_LAST_NAME=User
ADMIN_DEFAULT_MOBILE=9999999999

