# Set these in the deployment environment or in an ignored .env file.
LMS_DOMAIN=
DB_PASSWORD=
# PostgreSQL URL for the LMS database on the internal host db.
# URL-encode the password in this value if it contains reserved characters.
DATABASE_URL=
JWT_SECRET=
# Set a separate Fernet key when using SMTP. Re-enter previously configured passwords.
SMTP_ENCRYPTION_KEY=
SMTP_ALLOWED_HOSTS=smtp.gmail.com,smtp.office365.com,smtp.mail.yahoo.com
